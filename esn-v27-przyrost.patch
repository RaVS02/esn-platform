+.lang-opt.on { color: var(--accent); }
+.lang-opt.on .lang-code { color: var(--accent); }
 .theme-toggle { background: transparent; border: 1px solid var(--border2); color: var(--text2); width: 34px; height: 34px; margin: 0 8px 0 12px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex: none; font-size: 14px; transition: color .2s, border-color .2s, background .2s; }
 .theme-toggle:hover { color: var(--accent); border-color: var(--accent); background: rgba(var(--accent-rgb),0.08); }
