POSTGRES_USER=esn_admin
POSTGRES_PASSWORD=WPISZ_TUTAJ_BEZPIECZNE_HASLO
POSTGRES_DB=esn_db

# ── JWT (WSPÓLNY KLUCZ – KRYTYCZNY!) ────────────────────────────────
# Wygeneruj nowy klucz używając: openssl rand -hex 32
JWT_SECRET_KEY=WYGENEROWANY_LOSOWY_CIAG_HEX_32
SECRET_KEY=WYGENEROWANY_DRUGI_LOSOWY_CIAG_SESJI

# ── ADRESY URL ───────────────────────────────────────────────────────
PORTAL_URL=http://localhost

# ── AI (szczegóły: docs/AI.md) ───────────────────────────────────────
# Klucz platformy dla użytkowników bez własnego klucza (z dziennym limitem)
AI_PROVIDER=gemini                 # gemini | anthropic | openai_compat (Twoja Ollama / LM Studio)
GEMINI_API_KEY=TWÓJ_KLUCZ_GEMINI_API
#AI_SERVER_OPENAI_URL=http://192.168.0.108:11434/v1
#AI_SERVER_OPENAI_MODEL=llama3.1:8b
