# Szablon pliku .env – skopiuj do `.env` i uzupełnij. Plik `.env` jest w .gitignore i NIGDY nie trafia do repozytorium.
# Prawdziwe hasła i klucze wpisuj tylko do `.env` (lokalnie i na serwerze), nie do kodu, dokumentacji ani czatu.

# --- Baza danych (PostgreSQL) ---
POSTGRES_USER=esn_user
POSTGRES_PASSWORD=zmien_na_silne_haslo
POSTGRES_DB=esn_db
DATABASE_URL=postgresql://esn_user:zmien_na_silne_haslo@db:5432/esn_db

# --- Sesje (wspólny klucz portalu i magazynu) – losowy, min. 32 znaki, np.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Adresy ---
PORTAL_URL=http://localhost
ADMIN_EMAIL=

# --- Poczta (powiadomienia, kody weryfikacyjne, reset hasła) ---
# Konto Gmail z włączoną weryfikacją dwuetapową + „Hasło aplikacji” (Konto Google → Bezpieczeństwo → Hasła aplikacji).
# (Obsługiwane są też nazwy SMTP_SERVER / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_FROM.)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=

# --- Asystent AI (opcjonalnie) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_KEY_SECRET=
# AI_DAILY_LIMIT_USER=15

# --- v60: sesja i proxy ---
# Flaga Secure ciasteczka sesji: auto (domyślnie – gdy żądanie przyszło po HTTPS, np. przez Cloudflare), 1 = zawsze, 0 = nigdy
COOKIE_SECURE=auto
# Portal stoi za nginx/Cloudflare: IP klienta z CF-Connecting-IP / X-Forwarded-For (limity prób). 0 = ignoruj nagłówki proxy
TRUST_PROXY=1
